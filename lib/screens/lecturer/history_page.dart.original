  Widget build(BuildContext context) {
    final filteredSessions = _isLoading ? [] : _getFilteredSessions();
    
    // Group sessions by unit code for display
    Map<String, List<Map<String, dynamic>>> groupedByUnitCode = {};
    
    // Track unique sessions to prevent repetition
    Map<String, Map<String, dynamic>> uniqueSessionMap = {};
    
    for (var session in filteredSessions) {
      // ... existing code ...
    }
    
    return Scaffold(
      appBar: AppBar(
        title: Text('Attendance History'),
        backgroundColor: Colors.blue,
        actions: [
          // Filter button
          IconButton(
            icon: Icon(Icons.filter_list),
            tooltip: 'Filter History',
            onPressed: () {
              _showFilterOptions(context);
            },
          ),
          // Analysis button
          IconButton(
            icon: Icon(Icons.analytics),
            tooltip: 'Visual Analysis',
            onPressed: _sessions.isNotEmpty ? () {
              final filteredSessions = _getFilteredSessions();
              // Select the most recent session for analysis
              final mostRecentSession = filteredSessions.isNotEmpty ? 
                filteredSessions.first : _sessions.first;
              
              Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (context) => AnalysisPage(
                    sessionData: mostRecentSession,
                    relatedSessions: filteredSessions.isNotEmpty ? 
                      filteredSessions.cast<Map<String, dynamic>>() : 
                      _sessions.cast<Map<String, dynamic>>(),
                  ),
                ),
              );
            } : null,
          ),
        ],
      ),
      body: Column(
        children: [
          // Filter bar at the top
          Container(
            decoration: BoxDecoration(
              color: Colors.white,
              border: Border(
                bottom: BorderSide(
                  color: Colors.grey.shade300,
                  width: 1,
                ),
              ),
              boxShadow: [
                BoxShadow(
                  color: Colors.grey.withOpacity(0.1),
                  blurRadius: 4,
                  offset: Offset(0, 2),
                ),
              ],
            ),
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 8.0, vertical: 8.0),
              child: Row(
                children: [
                  // Date selector
                  Expanded(
                    child: Container(
                      height: 44,
                      decoration: BoxDecoration(
                        border: Border.all(color: Colors.grey.shade300),
                        borderRadius: BorderRadius.circular(4),
                      ),
                      child: InkWell(
                        onTap: () async {
                          final DateTime? picked = await showDatePicker(
                            context: context,
                            initialDate: _selectedDate ?? DateTime.now(),
                            firstDate: DateTime(2020),
                            lastDate: DateTime(2030),
                          );
                          if (picked != null && picked != _selectedDate) {
                            setState(() {
                              _selectedDate = picked;
                              _selectedWeek = 0; // Clear week selection
                            });
                          }
                        },
                        child: Row(
                          children: [
                            Padding(
                              padding: const EdgeInsets.symmetric(horizontal: 8.0),
                              child: Icon(Icons.calendar_today, color: Colors.grey.shade700),
                            ),
                            Expanded(
                              child: Text(
                                _selectedDate != null 
                                    ? DateFormat('d MMM yyyy').format(_selectedDate!)
                                    : 'Select date',
                                style: TextStyle(color: Colors.grey.shade700),
                              ),
                            ),
                            if (_selectedDate != null)
                              IconButton(
                                icon: Icon(Icons.clear, size: 18, color: Colors.grey.shade700),
                                onPressed: () {
                                  setState(() {
                                    _selectedDate = null;
                                  });
                                },
                              ),
                          ],
                        ),
                      ),
                    ),
                  ),
                  SizedBox(width: 8),
                  // Week selection dropdown
                  PopupMenuButton<Map<String, int>>(
                    tooltip: 'Select week',
                    child: Container(
                      height: 44,
                      padding: EdgeInsets.symmetric(horizontal: 12, vertical: 0),
                      decoration: BoxDecoration(
                        border: Border.all(color: Colors.grey.shade300),
                        borderRadius: BorderRadius.circular(4),
                      ),
                      child: Row(
                        children: [
                          Icon(Icons.date_range, color: Colors.grey.shade700),
                          SizedBox(width: 4),
                          Text(
                            _selectedWeek > 0 
                                ? 'Week $_selectedWeek of ${_getMonthName(_selectedMonth)}' 
                                : 'Select week',
                            style: TextStyle(color: Colors.grey.shade700),
                          ),
                          if (_selectedWeek > 0)
                            IconButton(
                              icon: Icon(Icons.clear, size: 18, color: Colors.grey.shade700),
                              padding: EdgeInsets.zero,
                              constraints: BoxConstraints(),
                              onPressed: () {
                                setState(() {
                                  _selectedWeek = 0;
                                  _selectedMonth = 0;
                                });
                              },
                          ),
                        ],
                      ),
                    ),
                    onSelected: (Map<String, int> value) {
                      setState(() {
                        _selectedWeek = value['week']!;
                        _selectedMonth = value['month']!;
                        _selectedDate = null; // Clear date selection
                      });
                    },
                    itemBuilder: (context) => _buildWeekSelectionItems(),
                  ),
                ],
              ),
            ),
          ),
          
          // Spinner or no data message
          if (_isLoading)
                  Expanded(
              child: Center(
                child: CircularProgressIndicator(),
              ),
            )
          else if (_sessions.isEmpty)
          Expanded(
              child: Center(
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Icon(
                              Icons.event_busy,
                              size: 64,
                              color: Colors.grey.shade400,
                            ),
                            SizedBox(height: 16),
                    Text(
                      'No attendance records found',
                      style: TextStyle(
                        fontSize: 18,
                        color: Colors.grey.shade700,
                      ),
                    ),
                    SizedBox(height: 8),
                            Text(
                              _selectedDate != null || _selectedWeek > 0
                          ? 'Try adjusting your date filter'
                          : 'Start taking attendance to see records here',
                      style: TextStyle(
                        color: Colors.grey.shade600,
                      ),
                    ),
                  ],
                ),
              ),
            )
          else
            // List of sessions grouped by unit code
            Expanded(
              child: ListView.builder(
                        itemCount: _sessions.length,
                        itemBuilder: (context, index) {
                          final session = _sessions[index];
                          
                          // Format the date for display
                          String displayDate = '';
                          if (session.containsKey('date')) {
                            try {
                              final date = DateTime.parse(session['date']);
                              displayDate = DateFormat('EEEE, MMMM d, yyyy').format(date);
                            } catch (e) {
                              displayDate = session['date'].toString();
                            }
                          } else if (session.containsKey('timestamp')) {
                            try {
                              final timestamp = session['timestamp'];
                              DateTime date;
                              if (timestamp is int) {
                                date = DateTime.fromMillisecondsSinceEpoch(timestamp);
                              } else if (timestamp is String) {
                                if (int.tryParse(timestamp) != null) {
                                  date = DateTime.fromMillisecondsSinceEpoch(int.parse(timestamp));
                                } else {
                                  date = DateTime.parse(timestamp);
                                }
                              } else {
                                date = DateTime.now();
                              }
                              displayDate = DateFormat('EEEE, MMMM d, yyyy').format(date);
                            } catch (e) {
                              displayDate = 'Unknown date';
                            }
                          }
                          
                          final attendeeDetails = session['attendeeDetails'] as List<dynamic>? ?? [];
                          
                          // Extract time if available
                          String timeStr = '';
                          if (session.containsKey('startTime') && session.containsKey('endTime')) {
                            timeStr = '${session['startTime']} - ${session['endTime']}';
                          }
                          
                          // Calculate present/absent counts
                          int presentCount = 0;
                          int absentCount = 0;
                          
                          for (var attendee in attendeeDetails) {
                            final details = attendee['details'];
                            bool isAbsent = false;
                            
                            if (details is Map) {
                              if (details.containsKey('status') && details['status'] == 'absent') {
                                isAbsent = true;
                              } else if (details.containsKey('timestamp') && details['timestamp'] == null) {
                                isAbsent = true;
                              }
                            }
                            
                            if (isAbsent) {
                              absentCount++;
                            } else {
                              presentCount++;
                            }
                          }
                          
                          return Padding(
                            padding: const EdgeInsets.symmetric(horizontal: 8.0, vertical: 4.0),
                            child: Card(
                              elevation: 2,
                              child: ExpansionTile(
                                title: Text(
                                  displayDate,
                                  style: TextStyle(fontWeight: FontWeight.bold),
                                ),
                                subtitle: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                                    if (timeStr.isNotEmpty) 
                                                      Text('Time: $timeStr'),
                                    Row(
                                      children: [
                                        Text(
                                                          'Present: $presentCount',
                                          style: TextStyle(
                                                          fontWeight: presentCount > 0 ? FontWeight.bold : FontWeight.normal,
                                                          color: presentCount > 0 ? Colors.green.shade800 : null,
                                                        ),
                                                      ),
                                                      Padding(
                                                        padding: const EdgeInsets.symmetric(horizontal: 8.0),
                                                        child: Text('|'),
                                                      ),
                                                      Text(
                                                        'Absent: $absentCount',
                                                        style: TextStyle(
                                                          fontWeight: absentCount > 0 ? FontWeight.bold : FontWeight.normal,
                                                          color: absentCount > 0 ? Colors.red.shade800 : null,
                                                        ),
                                                      ),
                                                      if (presentCount > 0)
                                        Padding(
                                          padding: const EdgeInsets.only(left: 8.0),
                                          child: Icon(
                                            Icons.group,
                                            size: 16,
                                            color: Colors.green.shade800,
                                          ),
                                        ),
                                    ],
                                  ),
                                ],
                              ),
                              children: [
                                Padding(
                                  padding: EdgeInsets.all(16),
                                  child: Column(
                                    crossAxisAlignment: CrossAxisAlignment.start,
                                    children: [
                                      if (session.containsKey('department'))
                                      Text(
                                        'Department: ${session['department']}',
                                        style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Colors.blue.shade800),
                                      ),
                                      if (session.containsKey('course'))
                                      Text(
                                        'Course: ${session['course']}',
                                        style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Colors.blue.shade800),
                                      ),
                                      // Always display year and semester
                                      Text(
                                        'Year: ${session['year'] ?? "3"}, Semester: ${session['semester'] ?? "2"}',
                                        style: TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: Colors.blue.shade700),
                                      ),
                                      SizedBox(height: 8),
                                      Row(
                                        mainAxisAlignment: MainAxisAlignment.end,
                                        children: [
                                          ElevatedButton.icon(
                                            icon: Icon(Icons.print),
                                            label: Text('Print Attendance'),
                                            style: ElevatedButton.styleFrom(
                                              backgroundColor: Colors.blue,
                                              foregroundColor: Colors.white,
                                            ),
                                            onPressed: () {
                                              // Get all sessions for this unit to provide context
                                              final relatedSessions = _sessions.where((s) => 
                                                s['unitCode'] == session['unitCode']).toList().cast<Map<String, dynamic>>();
                                              
                                              // Make sure we have course information in the session data
                                              if (!session.containsKey('department') || session['department'] == null || session['department'].isEmpty) {
                                                // Try to get department from the first attendee
                                                if (_sessions.isNotEmpty) {
                                                  final firstAttendee = _sessions.first;
                                                  if (firstAttendee is Map && firstAttendee.containsKey('department')) {
                                                    session['department'] = firstAttendee['department'];
                                                  }
                                                }
                                              }
                                              if (!session.containsKey('course') || session['course'] == null || session['course'].isEmpty) {
                                                // Try to get course from the first attendee
                                                if (_sessions.isNotEmpty) {
                                                  final firstAttendee = _sessions.first;
                                                  if (firstAttendee is Map && firstAttendee.containsKey('course')) {
                                                    session['course'] = firstAttendee['course'];
                                                  }
                                                }
                                              }
                                              
                                              Navigator.push(
                                                context,
                                                MaterialPageRoute(
                                                  builder: (context) => PrintAttendancePage(
                                                    sessionData: session,
                                                    relatedSessions: relatedSessions,
                                                  ),
                                                ),
                                              );
                                            },
                                          ),
                                        ],
                                      ),
                                    ],
                                  ),
                                ),
                              ],
                            ),
                          );
                        },
                      ),
                    ],
                  );
                },
                                              ),
                                            ),
                                        ],
                                      ),
    );
  }
  
  List<PopupMenuEntry<Map<String, int>>> _buildWeekSelectionItems() {
    List<PopupMenuEntry<Map<String, int>>> items = [];
    
    // Month sections
    for (int month = -2; month <= 2; month++) {
      String monthName = _getMonthName(month);
      String monthLabel;
      
      if (month == 0) {
        monthLabel = 'Current Month ($monthName)';
      } else if (month == -1) {
        monthLabel = 'Previous Month ($monthName)';
      } else if (month == -2) {
        monthLabel = '2 Months Ago ($monthName)';
      } else if (month == 1) {
        monthLabel = 'Next Month ($monthName)';
                                                      } else {
        monthLabel = '2 Months Ahead ($monthName)';
      }
      
      // Add month header
      items.add(
        PopupMenuItem<Map<String, int>>(
          enabled: false,
          child: Text(
            monthLabel,
                                                      style: TextStyle(
              fontWeight: FontWeight.bold,
              color: Colors.grey.shade800,
            ),
          ),
        ),
      );
      
      // Add weeks for this month
      for (int week = 1; week <= 4; week++) {
        items.add(
          PopupMenuItem<Map<String, int>>(
            value: {'week': week, 'month': month},
            child: Text('Week $week'),
          ),
        );
      }
      
      // Add divider if not the last month
      if (month < 2) {
        items.add(PopupMenuDivider());
      }
    }
    
    return items;
  }
} 

// AnalyzeAttendancePage for analyzing student attendance patterns
class AnalyzeAttendancePage extends StatefulWidget {
  final Map<String, dynamic> sessionData;
  final List<Map<String, dynamic>>? relatedSessions;

  AnalyzeAttendancePage({
    Key? key, 
    required this.sessionData, 
    this.relatedSessions
  }) : super(key: key);

  @override
  _AnalyzeAttendancePageState createState() => _AnalyzeAttendancePageState();
}

class _AnalyzeAttendancePageState extends State<AnalyzeAttendancePage> {
  bool _isLoading = false;
  List<Map<String, dynamic>> _attendanceData = [];
  final int _totalHoursPerSemester = 36; // 3 hours per week × 4 weeks × 3 months
  final double _attendanceThreshold = 0.7; // 70% attendance requirement
  
  // Define attendance categories
  final String _fullAttendance = "Full Attendance";
  final String _lowAttendance = "Low Attendance";
  final String _improvingAttendance = "Improving";
  final String _averageAttendance = "Average";
  
  @override
  void initState() {
    super.initState();
    _analyzeAttendance();
  }
  
  Future<void> _analyzeAttendance() async {
    setState(() {
      _isLoading = true;
    });
    
    try {
      // Gather all sessions for this unit
      List<Map<String, dynamic>> allSessions = [];
      if (widget.relatedSessions != null && widget.relatedSessions!.isNotEmpty) {
        allSessions = List.from(widget.relatedSessions!);
      } else {
        allSessions = [widget.sessionData];
      }
      
      // Extract unit information
      final unitCode = widget.sessionData['unitCode'] ?? 'Unknown';
      final unitName = widget.sessionData['unitName'] ?? 'Unknown';
      
      // Load all attendance records from SharedPreferences
      final prefs = await SharedPreferences.getInstance();
      
      // Get all keys that contain attendance data for this unit
      final allKeys = prefs.getKeys();
      List<String> attendanceKeys = [];
      
      // Look for session keys related to this unit
      for (String key in allKeys) {
        if (key.startsWith('session_') && key.contains(unitCode)) {
          attendanceKeys.add(key);
        }
      }
      
      // Get list of all students who have attended this unit
      Set<String> allStudentEmails = {};
      
      // Process each session to get attendees
      for (String key in attendanceKeys) {
        final String? sessionData = prefs.getString(key);
        if (sessionData != null) {
          final Map<String, dynamic> data = json.decode(sessionData);
          if (data.containsKey('attendees') && data['attendees'] is List) {
            for (var attendee in data['attendees']) {
              if (attendee is Map && attendee.containsKey('studentEmail')) {
                allStudentEmails.add(attendee['studentEmail']);
              }
            }
          }
        }
      }
      
      // Calculate attendance for each student
      List<Map<String, dynamic>> studentAttendance = [];
      
      for (String email in allStudentEmails) {
        int sessionsAttended = 0;
        String studentName = 'Unknown';
        List<bool> attendancePattern = [];
        Map<String, dynamic>? studentDetails;
        
        // Check each session for this student's attendance
        for (var session in allSessions) {
          if (session.containsKey('attendees') && session['attendees'] is List) {
            bool attended = false;
            for (var attendee in session['attendees']) {
              if (attendee is Map && attendee['studentEmail'] == email) {
                attended = true;
                // Get student details if not already retrieved
                if (studentName == 'Unknown' && attendee.containsKey('studentName')) {
                  studentName = attendee['studentName'];
                  studentDetails = Map.from(attendee);
                }
                break;
              }
            }
            attendancePattern.add(attended);
            if (attended) sessionsAttended++;
          }
        }
        
        // Calculate attendance percentage
        final totalSessions = allSessions.length > 0 ? allSessions.length : 1;
        final double attendancePercentage = sessionsAttended / totalSessions;
        
        // Calculate hours attended (assuming 3 hours per session)
        final hoursAttended = sessionsAttended * 3;
        
        // Determine if eligible for exam
        final bool isEligible = attendancePercentage >= _attendanceThreshold;
        
        // Determine attendance category
        String category;
        if (attendancePercentage >= 0.95) {
          category = _fullAttendance;
        } else if (attendancePercentage <= 0.4) {
          category = _lowAttendance;
        } else if (_isImproving(attendancePattern)) {
          category = _improvingAttendance;
        } else {
          category = _averageAttendance;
        }
        
        studentAttendance.add({
          'email': email,
          'name': studentName,
          'details': studentDetails,
          'sessionsAttended': sessionsAttended,
          'totalSessions': totalSessions,
          'attendancePercentage': attendancePercentage,
          'hoursAttended': hoursAttended,
          'isEligible': isEligible,
          'category': category,
          'attendancePattern': attendancePattern,
        });
      }
      
      // Sort by attendance percentage (descending)
      studentAttendance.sort((a, b) => 
        (b['attendancePercentage'] as double).compareTo(a['attendancePercentage'] as double));
      
      setState(() {
        _attendanceData = studentAttendance;
        _isLoading = false;
      });
    } catch (e) {
      print('Error analyzing attendance: $e');
      setState(() {
        _isLoading = false;
      });
    }
  }
  
  // Check if attendance is improving over time
  bool _isImproving(List<bool> pattern) {
    if (pattern.length < 3) return false;
    
    // Check last few sessions against earlier ones
    int midpoint = pattern.length ~/ 2;
    int earlyAttendance = 0;
    int lateAttendance = 0;
    
    for (int i = 0; i < midpoint; i++) {
      if (pattern[i]) earlyAttendance++;
    }
    
    for (int i = midpoint; i < pattern.length; i++) {
      if (pattern[i]) lateAttendance++;
    }
    
    // Calculate percentage improvement
    final earlyRate = earlyAttendance / midpoint;
    final lateRate = lateAttendance / (pattern.length - midpoint);
    
    return lateRate > earlyRate && (lateRate - earlyRate) > 0.2; // At least 20% improvement
  }
  
  @override
  Widget build(BuildContext context) {
    // Get unit information
    final unitCode = widget.sessionData['unitCode'] ?? 'Unknown Unit';
    final unitName = widget.sessionData['unitName'] ?? 'Unknown';
    
    return Scaffold(
      appBar: AppBar(
        title: Text('Attendance Analysis'),
        actions: [
          IconButton(
            icon: Icon(Icons.print),
            tooltip: 'Print Analysis',
            onPressed: _generatePDF,
          ),
        ],
      ),
      body: _isLoading
        ? Center(child: CircularProgressIndicator())
        : _attendanceData.isEmpty
          ? Center(
              child: Text(
                'No attendance data available for analysis.',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
              ),
            )
          : SingleChildScrollView(
              padding: EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // Unit information header
                  Container(
                    padding: EdgeInsets.all(16),
                    decoration: BoxDecoration(
                      color: Colors.blue.shade50,
                      borderRadius: BorderRadius.circular(8),
                      border: Border.all(color: Colors.blue.shade200)
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'Unit: $unitCode - $unitName',
                          style: TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        SizedBox(height: 8),
                        Text(
                          'Total Sessions: ${_attendanceData.isNotEmpty ? _attendanceData[0]['totalSessions'] : 0}',
                          style: TextStyle(fontSize: 16),
                        ),
                        Text(
                          'Total Students: ${_attendanceData.length}',
                          style: TextStyle(fontSize: 16),
                        ),
                        Text(
                          'Required Attendance: 70% (${(_totalHoursPerSemester * 0.7).round()} hours out of $_totalHoursPerSemester)',
                          style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                        ),
                      ],
                    ),
                  ),
                  
                  SizedBox(height: 24),
                  
                  // Summary statistics
                  Text(
                    'Attendance Summary',
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  SizedBox(height: 16),
                  
                  // Statistics cards
                  Row(
                    children: [
                      _buildStatCard(
                        'Eligible for Exams',
                        _attendanceData.where((s) => s['isEligible'] == true).length,
                        _attendanceData.length,
                        Colors.green,
                      ),
                      SizedBox(width: 16),
                      _buildStatCard(
                        'At Risk',
                        _attendanceData.where((s) => s['isEligible'] == false).length,
                        _attendanceData.length,
                        Colors.red,
                      ),
                    ],
                  ),
                  
                  SizedBox(height: 16),
                  
                  Row(
                    children: [
                      _buildStatCard(
                        'Full Attendance',
                        _attendanceData.where((s) => s['category'] == _fullAttendance).length,
                        _attendanceData.length,
                        Colors.blue,
                      ),
                      SizedBox(width: 16),
                      _buildStatCard(
                        'Low Attendance',
                        _attendanceData.where((s) => s['category'] == _lowAttendance).length,
                        _attendanceData.length,
                        Colors.orange,
                      ),
                    ],
                  ),
                  
                  SizedBox(height: 24),
                  
                  // Student list with attendance details
                  Text(
                    'Student Attendance Details',
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  SizedBox(height: 16),
                  
                  // Table header
                  Container(
                    padding: EdgeInsets.symmetric(vertical: 8, horizontal: 16),
                    color: Colors.grey.shade200,
                    child: Row(
                      children: [
                        Expanded(
                          flex: 3,
                          child: Text(
                            'Student',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                        Expanded(
                          flex: 2,
                          child: Text(
                            'Attendance',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                        Expanded(
                          flex: 2,
                          child: Text(
                            'Hours',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                        Expanded(
                          flex: 2,
                          child: Text(
                            'Status',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                      ],
                    ),
                  ),
                  
                  // Student list
                  ...List.generate(_attendanceData.length, (index) {
                    final student = _attendanceData[index];
                    final bool isEligible = student['isEligible'];
                    final double percentage = student['attendancePercentage'] * 100;
                    final Color statusColor = isEligible ? Colors.green : Colors.red;
                    
                    return Container(
                      decoration: BoxDecoration(
                        border: Border(bottom: BorderSide(color: Colors.grey.shade300)),
                      ),
                      child: ExpansionTile(
                        title: Row(
                          children: [
                            Expanded(
                              flex: 3,
                              child: Text(student['name']),
                            ),
                            Expanded(
                              flex: 2,
                              child: Text('${percentage.toStringAsFixed(1)}%'),
                            ),
                            Expanded(
                              flex: 2,
                              child: Text('${student['hoursAttended']} / $_totalHoursPerSemester'),
                            ),
                            Expanded(
                              flex: 2,
                              child: Text(
                                isEligible ? 'Eligible' : 'At Risk',
                                style: TextStyle(
                                  color: statusColor,
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                            ),
                          ],
                        ),
                        subtitle: Text(
                          'Category: ${student['category']}',
                          style: TextStyle(
                            fontStyle: FontStyle.italic,
                          ),
                        ),
                        children: [
                          Padding(
                            padding: EdgeInsets.all(16),
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'Email: ${student['email']}',
                                  style: TextStyle(fontSize: 14),
                                ),
                                SizedBox(height: 8),
                                Text(
                                  'Sessions Attended: ${student['sessionsAttended']} out of ${student['totalSessions']}',
                                  style: TextStyle(fontSize: 14),
                                ),
                                SizedBox(height: 16),
                                Text(
                                  'Attendance Pattern:',
                                  style: TextStyle(fontWeight: FontWeight.bold),
                                ),
                                SizedBox(height: 8),
                                _buildAttendancePatternIndicator(student['attendancePattern']),
                                SizedBox(height: 16),
                                Text(
                                  _getRecommendation(student),
                                  style: TextStyle(
                                    fontStyle: FontStyle.italic,
                                    color: isEligible ? Colors.green.shade800 : Colors.red.shade800,
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                    );
                  }),
                ],
              ),
            ),
      floatingActionButton: FloatingActionButton(
        onPressed: _generatePDF,
        tooltip: 'Generate Report',
        child: Icon(Icons.picture_as_pdf),
      ),
    );
  }
  
  Widget _buildStatCard(String title, int value, int total, Color color) {
    final percentage = total > 0 ? (value / total * 100).toStringAsFixed(1) : '0';
    
    return Expanded(
      child: Container(
        padding: EdgeInsets.all(16),
        decoration: BoxDecoration(
          color: color.withOpacity(0.1),
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: color.withOpacity(0.3)),
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              title,
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.bold,
              ),
            ),
            SizedBox(height: 8),
            Text(
              '$value / $total ($percentage%)',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
                color: color,
              ),
            ),
          ],
        ),
      ),
    );
  }
  
  Widget _buildAttendancePatternIndicator(List<bool> pattern) {
    return Row(
      children: pattern.map((attended) {
        return Container(
          margin: EdgeInsets.symmetric(horizontal: 2),
          width: 20,
          height: 20,
          decoration: BoxDecoration(
            color: attended ? Colors.green : Colors.red,
            borderRadius: BorderRadius.circular(4),
          ),
          child: Center(
            child: Icon(
              attended ? Icons.check : Icons.close,
              color: Colors.white,
              size: 14,
            ),
          ),
        );
      }).toList(),
    );
  }
  
  String _getRecommendation(Map<String, dynamic> student) {
    final bool isEligible = student['isEligible'];
    final double percentage = student['attendancePercentage'] * 100;
    final String category = student['category'];
    
    if (isEligible) {
      if (category == _fullAttendance) {
        return 'Excellent attendance. Student is eligible for examinations.';
      } else if (category == _improvingAttendance) {
        return 'Attendance has been improving. Student is eligible for examinations.';
      } else {
        return 'Student meets the minimum attendance requirements for examinations.';
      }
    } else {
      if (category == _lowAttendance) {
        return 'Warning: Student has critically low attendance and is not eligible for examinations.';
      } else if (category == _improvingAttendance) {
        return 'Student shows improvement but still needs more attendance to qualify for examinations.';
      } else {
        return 'Student does not meet the minimum attendance requirement for examinations.';
      }
    }
  }
  
  Future<void> _generatePDF() async {
    setState(() {
      _isLoading = true;
    });

    try {
      // Create PDF document
      final pdf = pw.Document();
      
      // Get unit info
      final unitCode = widget.sessionData['unitCode'] ?? 'Unknown';
      final unitName = widget.sessionData['unitName'] ?? 'Unknown';
      final department = widget.sessionData['department'] ?? '';
      final course = widget.sessionData['course'] ?? '';
      final year = widget.sessionData['year'] ?? '';
      final semester = widget.sessionData['semester'] ?? '';
      
      // Load logo image for PDF
      final ByteData? logoData = await rootBundle.load('assets/images/university_logo.png');
      final Uint8List? logoBytes = logoData?.buffer.asUint8List();
      final pw.MemoryImage? logoImage = logoBytes != null ? pw.MemoryImage(logoBytes) : null;
      
      // Add page to PDF document
      pdf.addPage(
        pw.Page(
          pageFormat: PdfPageFormat.a4,
          build: (pw.Context context) {
            return pw.Column(
              crossAxisAlignment: pw.CrossAxisAlignment.start,
              children: [
                // University header with logo
                pw.Center(
                  child: logoImage != null 
                    ? pw.Container(
                        height: 100,
                        width: double.infinity,
                        child: pw.Image(logoImage, fit: pw.BoxFit.contain),
                      )
                    : pw.Container(
                        height: 70,
                        child: pw.Text('UNIVERSITY LOGO', 
                          style: pw.TextStyle(
                            fontSize: 24, 
                            fontWeight: pw.FontWeight.bold
                          )
                        ),
                      ),
                ),
                
                pw.SizedBox(height: 20),
                
                // Report header
                pw.Center(
                  child: pw.Text(
                    'ATTENDANCE ANALYSIS REPORT',
                    style: pw.TextStyle(
                      fontSize: 18,
                      fontWeight: pw.FontWeight.bold,
                      decoration: pw.TextDecoration.underline,
                    ),
                  ),
                ),
                
                pw.SizedBox(height: 16),
                
                // Academic and unit information
                pw.Container(
                  padding: pw.EdgeInsets.all(10),
                  margin: pw.EdgeInsets.only(bottom: 16),
                  decoration: pw.BoxDecoration(
                    color: PdfColor.fromInt(0xfff5f5f5), // grey100
                    border: pw.Border.all(color: PdfColor.fromInt(0xff1565c0), width: 1), // blue800
                  ),
                  child: pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      if (department.isNotEmpty)
                        pw.Text('Department: $department', 
                          style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 12)),
                      if (course.isNotEmpty)
                        pw.Text('Course: $course', 
                          style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 12)),
                      if (year.isNotEmpty && semester.isNotEmpty)
                        pw.Text('Year: $year, Semester: $semester', 
                          style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 12)),
                    ],
                  ),
                ),
                
                pw.Row(
                  children: [
                    pw.Expanded(
                      child: pw.Column(
                        crossAxisAlignment: pw.CrossAxisAlignment.start,
                        children: [
                          pw.Text('Unit Code: $unitCode', style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                          pw.Text('Unit Title: $unitName', style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                          pw.Text('Date: ${DateTime.now().toString().substring(0, 10)}', 
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                        ],
                      ),
                    ),
                    pw.Expanded(
                      child: pw.Column(
                        crossAxisAlignment: pw.CrossAxisAlignment.end,
                        children: [
                          pw.Text('Total Students: ${_attendanceData.length}', 
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                          pw.Text('Required Attendance: 70%', 
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                          pw.Text('Required Hours: ${(_totalHoursPerSemester * 0.7).round()} of $_totalHoursPerSemester', 
                            style: pw.TextStyle(fontWeight: pw.FontWeight.bold)),
                        ],
                      ),
                    ),
                  ],
                ),
                
                pw.SizedBox(height: 20),
                
                // Attendance summary statistics
                pw.Text('Attendance Summary:', style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 14)),
                pw.SizedBox(height: 5),
                
                // Create summary statistics
                pw.Container(
                  padding: pw.EdgeInsets.all(10),
                  decoration: pw.BoxDecoration(
                    color: PdfColor.fromInt(0xfff5f5f5), // grey100
                  ),
                  child: pw.Column(
                    children: [
                      _buildPdfStatRow(
                        'Eligible for Exams',
                        _attendanceData.where((s) => s['isEligible'] == true).length,
                        _attendanceData.length,
                        PdfColor.fromInt(0xff008800)  // Green
                      ),
                      _buildPdfStatRow(
                        'At Risk Students',
                        _attendanceData.where((s) => s['isEligible'] == false).length,
                        _attendanceData.length,
                        PdfColor.fromInt(0xffcc0000)  // Red
                      ),
                      _buildPdfStatRow(
                        'Full Attendance',
                        _attendanceData.where((s) => s['category'] == _fullAttendance).length,
                        _attendanceData.length,
                        PdfColor.fromInt(0xff0000cc)  // Blue
                      ),
                      _buildPdfStatRow(
                        'Low Attendance',
                        _attendanceData.where((s) => s['category'] == _lowAttendance).length,
                        _attendanceData.length,
                        PdfColor.fromInt(0xffff8800)  // Orange
                      ),
                    ],
                  ),
                ),
                
                pw.SizedBox(height: 20),
                
                // Students Table
                pw.Text('Student Attendance Details:', style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 14)),
                pw.SizedBox(height: 10),
                
                // Create table with attendance data
                pw.Table(
                  border: pw.TableBorder.all(color: PdfColor.fromInt(0xff000000)), // black
                  columnWidths: {
                    0: pw.FlexColumnWidth(3),
                    1: pw.FlexColumnWidth(3),
                    2: pw.FlexColumnWidth(2),
                    3: pw.FlexColumnWidth(2),
                    4: pw.FlexColumnWidth(2),
                    5: pw.FlexColumnWidth(2),
                  },
                  children: [
                    // Table header
                    pw.TableRow(
                      decoration: pw.BoxDecoration(color: PdfColor.fromInt(0xffe0e0e0)), // grey300
                      children: [
                        _pdfTableCell('Student Name', isHeader: true),
                        _pdfTableCell('Email', isHeader: true),
                        _pdfTableCell('Attendance %', isHeader: true),
                        _pdfTableCell('Hours', isHeader: true),
                        _pdfTableCell('Category', isHeader: true),
                        _pdfTableCell('Status', isHeader: true),
                      ],
                    ),
                    
                    // Table rows for each student
                    ..._attendanceData.map((student) {
                      final percentage = (student['attendancePercentage'] * 100).toStringAsFixed(1);
                      final isEligible = student['isEligible'] as bool;
                      final hours = student['hoursAttended'] as int;
                      
                      return pw.TableRow(
                        decoration: pw.BoxDecoration(
                          color: isEligible ? null : PdfColor.fromInt(0xffffebee), // red50
                        ),
                        children: [
                          _pdfTableCell(student['name']),
                          _pdfTableCell(student['email']),
                          _pdfTableCell('$percentage%'),
                          _pdfTableCell('$hours/$_totalHoursPerSemester'),
                          _pdfTableCell(student['category']),
                          _pdfTableCell(
                            isEligible ? 'Eligible' : 'At Risk',
                            textColor: isEligible ? PdfColor.fromInt(0xff008800) : PdfColor.fromInt(0xffcc0000),
                          ),
                        ],
                      );
                    }).toList(),
                  ],
                ),
                
                pw.SizedBox(height: 20),
                
                // Recommendations and notes
                pw.Text('Recommendations:', style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 14)),
                pw.SizedBox(height: 5),
                pw.Container(
                  padding: pw.EdgeInsets.all(10),
                  decoration: pw.BoxDecoration(
                    border: pw.Border.all(color: PdfColor.fromInt(0xff9e9e9e)), // grey
                    borderRadius: pw.BorderRadius.circular(5),
                  ),
                  child: pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      pw.Text('1. Students with attendance below 70% are at risk of being barred from examinations.'),
                      pw.SizedBox(height: 5),
                      pw.Text('2. Consider conducting intervention sessions for students with low attendance.'),
                      pw.SizedBox(height: 5),
                      pw.Text('3. Review teaching strategies for sessions with generally low attendance.'),
                      pw.SizedBox(height: 5),
                      pw.Text('4. Required minimum attendance for exams: ${(_totalHoursPerSemester * 0.7).round()} hours out of $_totalHoursPerSemester hours.'),
                    ],
                  ),
                ),
                
                pw.Spacer(),
                
                // Footer with date and page number
                pw.Row(
                  mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                  children: [
                    pw.Text('Generated: ${DateTime.now().toString().substring(0, 19)}'),
                    pw.Text('QR Code Attendance App'),
                  ],
                ),
              ],
            );
          },
        ),
      );
      
      // Print the document
      await Printing.layoutPdf(
        onLayout: (PdfPageFormat format) async => pdf.save(),
      );
    } catch (e) {
      print('Error generating PDF: $e');
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error generating PDF report: $e')),
      );
    }
    
    setState(() {
      _isLoading = false;
    });
  }
  
  pw.Widget _buildPdfStatRow(String label, int value, int total, PdfColor color) {
    final percentage = total > 0 ? (value / total * 100).toStringAsFixed(1) : '0';
    
    return pw.Padding(
      padding: pw.EdgeInsets.symmetric(vertical: 2),
      child: pw.Row(
        mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
        children: [
          pw.Text(label),
          pw.Text(
            '$value / $total ($percentage%)',
            style: pw.TextStyle(
              color: color,
              fontWeight: pw.FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }
  
  pw.Widget _pdfTableCell(String text, {bool isHeader = false, PdfColor? textColor}) {
    return pw.Padding(
      padding: pw.EdgeInsets.all(6),
      child: pw.Text(
        text,
        style: pw.TextStyle(
          fontWeight: isHeader ? pw.FontWeight.bold : null,
          color: textColor,
        ),
      ),
    );
  }
} 